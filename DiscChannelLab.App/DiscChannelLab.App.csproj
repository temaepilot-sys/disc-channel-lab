<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DiscChannelLab</AssemblyName>
    <Product>DiscChannelLab</Product>
  </PropertyGroup>

  <ItemGroup Condition="'$(ToolsBundleId)' != '' and Exists('obj/embedded-tools/tools.bundle.zip')">
    <EmbeddedResource Include="obj/embedded-tools/tools.bundle.zip"
                      LogicalName="Disc2Flac.tools.$(ToolsBundleId).zip" />
  </ItemGroup>

  <Target Name="ValidateEmbeddedTools" BeforeTargets="PrepareForBuild" Condition="'$(ToolsBundleId)' != ''">
    <PropertyGroup>
      <_ToolsBundleIdValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(ToolsBundleId)', '\A[0-9a-fA-F]{16}\z'))</_ToolsBundleIdValid>
    </PropertyGroup>
    <Error Condition="'$(_ToolsBundleIdValid)' != 'True'"
           Text="ToolsBundleId must contain exactly 16 hexadecimal characters. Use the first 16 characters of the tools bundle SHA256." />
    <Error Condition="!Exists('obj/embedded-tools/tools.bundle.zip')"
           Text="The embedded tools bundle is missing. Build the personal application with build-personal.ps1." />
  </Target>

  <ItemGroup>
    <Content Include="../tools/steamaudio/*.dll" Link="tools/steamaudio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../tools/steamaudio/LICENSE.txt;../tools/steamaudio/THIRDPARTY.md;../tools/steamaudio/provenance.json" Link="tools/steamaudio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
