<Window x:Class="Disc2Flac.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Disc2Flac"
        Title="{local:Loc Key='曲情報とチャプター名を一括編集'}" Width="760" Height="700"
        MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TargetText" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{local:Loc Key='曲名は上から1行ずつ対応します。⇥ の後にアーティスト名を加えると、その曲のアーティストも変更できます。貼り付けたタブも ⇥ と表示します。'}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{local:Loc Key='ディスク名（親フォルダー）'}" VerticalAlignment="Center"/>
            <TextBox x:Name="AlbumBox" Grid.Column="1" MinHeight="30" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ArtistCheck" Content="{local:Loc Key='選択行のアーティスト'}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="ArtistBox" MinHeight="30" VerticalContentAlignment="Center"
                         IsEnabled="{Binding IsChecked, ElementName=ArtistCheck}"/>
                <TextBlock x:Name="ArtistTargetsText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="EditorTabs" Grid.Row="3">
            <TabItem Header="{local:Loc Key='曲名と曲ごとのアーティスト'}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{local:Loc Key='1行1曲。区切りの ⇥ はタブを見える形で表示しています。スペースとは別です。'}"
                               TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <AdornerDecorator Grid.Row="1">
                        <TextBox x:Name="TitlesBox" AcceptsReturn="True" AcceptsTab="True"
                                 TextChanged="TitlesBox_TextChanged"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14"
                                 Padding="8" SpellCheck.IsEnabled="False"/>
                    </AdornerDecorator>
                </Grid>
            </TabItem>
            <TabItem Header="{local:Loc Key='チャプター名'}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ChapterCountText" TextWrapping="Wrap" Margin="0,0,0,7"/>
                    <TextBox x:Name="ChapterNamesBox" Grid.Row="1" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="14"
                             Padding="8" SpellCheck.IsEnabled="False"/>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{local:Loc Key='キャンセル'}" Width="100" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{local:Loc Key='反映する'}" Width="100" IsDefault="True" Click="Apply_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
