<Window x:Class="Disc2Flac.SpatialLabWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Spatial Lab — SOFA / Binaural / Room / ADM" Width="1080" Height="820" MinWidth="920" MinHeight="700"
 Background="{DynamicResource AppBackgroundBrush}" WindowStartupLocation="CenterOwner" PreviewKeyDown="SceneWindow_KeyDown">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="SceneLabelsVisibilityConverter"/>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3,7,3"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,3,10,5"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,3,10,5"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="11,8"><ContentPresenter ContentSource="Header" TextElement.Foreground="{DynamicResource TextBrush}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Spatial Lab" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Playback, track selection and FLAC export: main window · Head orientation and levels: Headphones / mixer" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/><TextBlock x:Name="ActiveHrtfText" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="ActiveRoomText" TextWrapping="Wrap" Margin="0,3,0,10"/></StackPanel>
  <TabControl x:Name="Pages" Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
   <TabItem x:Name="HrirLibraryTab" Header="1 · HRTF Library"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><WrapPanel><Button Content="Add SOFA…" Click="AddSofa_Click"/><Button Content="Revalidate" Click="Revalidate_Click"/><Button Content="Remove" Click="Remove_Click"/></WrapPanel><TextBlock Text="Select a compatible HRTF to apply it to the main player. During playback, switching resumes at the same position after a brief pause." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/></StackPanel>
    <DataGrid x:Name="LibraryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Library_Changed" Margin="0,8,0,10">
     <DataGrid.Columns><DataGridTextColumn Header="HRTF" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Directions" Binding="{Binding Directions}" Width="85"/><DataGridTextColumn Header="Hz" Binding="{Binding SampleRate}" Width="85"/><DataGridTextColumn Header="Convention" Binding="{Binding Convention}" Width="180"/></DataGrid.Columns>
    </DataGrid>
    <TextBox x:Name="LibraryDetails" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" Height="185" VerticalScrollBarVisibility="Auto"/>
   </Grid></TabItem>
   <TabItem x:Name="ComparisonTab" Header="2 · Compare / Export"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="1. Select the versions and interval → 2. Prepare A/B → 3. Play A or B" FontWeight="SemiBold"/>
    <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,4,0,12"/>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="Source presentation · shared with the main player" FontWeight="SemiBold"/>
      <WrapPanel>
       <ComboBox x:Name="ComparisonPresentationCombo" ItemsSource="{Binding AtmosPreviewChoices}" DisplayMemberPath="Label" Width="285"
                 SelectedItem="{Binding SelectedAtmosPreview, Mode=OneWay}" SelectionChanged="ComparisonPresentation_Changed" IsEnabled="{Binding CanChooseAtmosPresentation}"/>
       <Button x:Name="ComparisonUse51Button" Content="Use 5.1 for HRIR / BRIR" Click="ComparisonUse51_Click"/>
      </WrapPanel>
      <TextBlock x:Name="ComparisonPresentationHint" Text="{Binding AtmosPresentationHint}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
     </StackPanel>
    </Border>
    <WrapPanel><StackPanel Width="160"><TextBlock Text="Start in selected track (s)"/><TextBox x:Name="IntervalStart" Text="0" TextChanged="ComparisonInput_Changed"/></StackPanel><StackPanel Width="160"><TextBlock Text="Compare length (5–60 s)"/><TextBox x:Name="IntervalLength" Text="15" TextChanged="ComparisonInput_Changed"/></StackPanel>
     <StackPanel Width="100"><TextBlock Text="Yaw °"/><TextBox x:Name="FixedYaw" Text="0" TextChanged="ComparisonInput_Changed"/></StackPanel><StackPanel Width="100"><TextBlock Text="Pitch °"/><TextBox x:Name="FixedPitch" Text="0" TextChanged="ComparisonInput_Changed"/></StackPanel><StackPanel Width="100"><TextBlock Text="Roll °"/><TextBox x:Name="FixedRoll" Text="0" TextChanged="ComparisonInput_Changed"/></StackPanel></WrapPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="A / export HRIR"/><ComboBox x:Name="HrtfA" SelectionChanged="ComparisonInput_Changed"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="B / HRIR (used for HRIR vs HRIR)"/><ComboBox x:Name="HrtfB" SelectionChanged="ComparisonInput_Changed"/></StackPanel></Grid>
    <TextBlock Text="These A/B choices are used by Prepare A/B and export. To change live main playback, select an HRTF on tab 1." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <CheckBox x:Name="MatchLevel" Content="Match loudness (attenuation only; up to 6 dB for HRIR, 30 dB for HRIR / BRIR)" IsChecked="True" Margin="0,8" Checked="ComparisonInput_Changed" Unchecked="ComparisonInput_Changed"/>
    <CheckBox x:Name="CompareRoom" Content="HRIR vs room: A = Pure HRIR A, B = HRIR A + current reflections" Margin="0,4,0,8" Checked="ComparisonInput_Changed" Unchecked="ComparisonInput_Changed"/>
    <CheckBox x:Name="CompareBrir" Content="HRIR vs BRIR: A = Pure HRIR A, B = loaded BRIR on tab 4 · head at 0°" Margin="0,4,0,8" Checked="ComparisonInput_Changed" Unchecked="ComparisonInput_Changed"/>
    <TextBlock Text="With both options OFF: HRIR A vs HRIR B. Prepare renders the interval without playing it. Play A / B each restart at the Start position above; click the other button to switch." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,6"/>
    <WrapPanel><Button x:Name="ComparisonPrepareButton" Content="Prepare A/B" Click="Compare_Click"/><Button x:Name="ComparisonPlayAButton" Content="Play A from start" Click="PlayA_Click" IsEnabled="False"/><Button x:Name="ComparisonPlayBButton" Content="Play B from start" Click="PlayB_Click" IsEnabled="False"/><Button x:Name="ComparisonStopButton" Content="Stop A/B" Click="StopComparison_Click" IsEnabled="False"/></WrapPanel>
    <TextBlock x:Name="ComparisonFeedback" Text="Not prepared. Select A / B or HRIR vs BRIR, then press Prepare A/B." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5"/>
    <ProgressBar x:Name="ComparisonProgress" Height="5" Minimum="0" Maximum="1" Margin="0,3"/>
    <TextBlock x:Name="ComparisonPosition" Text="" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,6"/>
    <TextBox x:Name="ComparisonText" Text="Prepare A/B to measure the same fixed-pose interval." Height="90" IsReadOnly="True" TextWrapping="Wrap"/>
    <TextBlock Text="Listening notes · externalization / front-back / elevation / timbre / distance" Margin="0,8,0,0"/>
    <TextBox x:Name="EvaluationNotes" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto"/>
    <TextBox x:Name="EquipmentNotes" Text="Headphones / ANC / Windows spatial processing / device / volume conditions"/>
    <WrapPanel><ComboBox x:Name="Verdict" Width="140" SelectedIndex="2"><ComboBoxItem Content="Prefer A"/><ComboBoxItem Content="Prefer B"/><ComboBoxItem Content="Equivalent"/></ComboBox><Button Content="Save evaluation" Click="SaveEvaluation_Click"/></WrapPanel>
    <Separator Margin="0,12"/><TextBlock Text="Float WAV for analysis · HRTF A / fixed pose / room above · 48 kHz" FontWeight="SemiBold"/>
    <WrapPanel><ComboBox x:Name="ExportRange" Width="240" SelectedIndex="0"><ComboBoxItem Content="Comparison interval"/><ComboBoxItem Content="Whole selected main-player track"/></ComboBox><CheckBox x:Name="KeepTail" Content="Keep filter / room tail" IsChecked="True" VerticalAlignment="Center"/></WrapPanel>
    <CheckBox x:Name="ExportBrir" Content="Use loaded Measured BRIR for float WAV export (neutral head)" Margin="0,5"/>
    <Button Content="Export float WAV…" Click="ExportWav_Click" HorizontalAlignment="Left"/>
    <TextBlock Text="For song-by-song FLAC, use Save FLAC in the main window and enable headphone / reflection rendering. Float WAV retains above-unity PCM; a .render.json records the settings." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="HrirRoomTab" Header="3 · HRIR / Reflections"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="Short, directional early reflections — not a long reverb. Settings apply automatically to main playback. Pure HRTF = OFF. Studio is subtle; Listening Room is a stronger starting preset. Switching holds the playback position." TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ComboBox x:Name="RoomMode" SelectedIndex="0" SelectionChanged="RoomMode_Changed"><ComboBoxItem Content="Pure HRTF"/><ComboBoxItem Content="Studio"/><ComboBoxItem Content="Listening Room"/><ComboBoxItem Content="Big Room"/></ComboBox>
    <TextBlock Text="Big Room: an audible test preset with a 10 × 14 × 6 m room, stronger reflections and longer paths. It uses the same six first-order reflections, without a church-like late reverb. Check output peaks when comparing." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8"/>
    <TextBlock Text="Reflection strength (dB per wall, before distance and absorption)" Margin="0,8,0,0"/>
    <Slider x:Name="ReflectionLevel" Minimum="-60" Maximum="0" Value="-18" TickFrequency="3" SmallChange="1" LargeChange="3" ValueChanged="ReflectionLevel_Changed" Margin="0,5,0,12"/>
    <UniformGrid Columns="3"><StackPanel><TextBlock Text="Width (m)"/><TextBox x:Name="RoomWidth" Text="4.5" TextChanged="RoomField_Changed"/></StackPanel><StackPanel><TextBlock Text="Depth (m)"/><TextBox x:Name="RoomDepth" Text="3.5" TextChanged="RoomField_Changed"/></StackPanel><StackPanel><TextBlock Text="Height (m)"/><TextBox x:Name="RoomHeight" Text="2.6" TextChanged="RoomField_Changed"/></StackPanel>
     <StackPanel><TextBlock Text="Listener above floor (m)"/><TextBox x:Name="ListenerHeight" Text="1.2" TextChanged="RoomField_Changed"/></StackPanel><StackPanel><TextBlock Text="Scene unit radius (m)"/><TextBox x:Name="SpeakerRadius" Text="1.2" TextChanged="RoomField_Changed"/></StackPanel><StackPanel><TextBlock Text="Per-reflection level (dB)"/><TextBox x:Name="ReflectionDb" Text="-18" TextChanged="RoomField_Changed"/></StackPanel>
     <StackPanel><TextBlock Text="Low absorption (0–1)"/><TextBox x:Name="LowAbsorption" Text="0.15" TextChanged="RoomField_Changed"/></StackPanel><StackPanel><TextBlock Text="Mid absorption (0–1)"/><TextBox x:Name="MidAbsorption" Text="0.3" TextChanged="RoomField_Changed"/></StackPanel><StackPanel><TextBlock Text="High absorption (0–1)"/><TextBox x:Name="HighAbsorption" Text="0.55" TextChanged="RoomField_Changed"/></StackPanel></UniformGrid>
    <CheckBox x:Name="SoloReflections" Content="Reflections only · mute direct sound and LFE to hear the added paths" Checked="RoomCheck_Changed" Unchecked="RoomCheck_Changed" Margin="0,12"/>
    <WrapPanel><Button Content="Reset: reflections OFF" Click="ResetRoom_Click"/><Button x:Name="RoomCompareButton" Content="Prepare OFF / ON A/B" Click="RoomCompare_Click"/></WrapPanel>
    <TextBlock x:Name="RoomDiagnosticText" TextWrapping="Wrap" Margin="0,10" FontWeight="SemiBold"/>
    <TextBlock Text="The level above is reduced further by distance and wall absorption. If the effect is hard to hear, try Listening Room at −6 dB, then use Reflections only or OFF / ON A/B. This is an audition setting, not a reference standard; watch the clipped-sample count at stronger levels. Atmos Stereo presentation bypasses this effect." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
    <TextBlock Text="To identify the effect: choose Listening Room, enable Reflections only, then turn it off to restore direct + reflected sound. OFF / ON A/B uses the same HRTF, pose and source interval with optional loudness matching. Settings are saved automatically." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <TextBlock Text="Reflection delay uses excess path length relative to the unchanged dry signal. Wall absorption is a three-band approximation. No late reverb or occlusion. These values are listening presets, not acoustical standards." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,16"/>
    <TextBlock Text="Use A/B with the same HRTF, or save Pure and Studio versions to compare. Reflections can color recordings that already contain reverb." TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="BrirTab" Header="4 · Measured BRIR"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <TextBlock Text="A measured room · an alternative to Pure HRIR" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="Fixed head and explicitly mapped speakers. BRIR replaces HRIR; additional reflections are bypassed. Load your own measured responses. No BRIR dataset is bundled." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
    <WrapPanel><Button x:Name="ApplyBrirButton" Content="Validate and apply BRIR" Click="ApplyBrir_Click"/><Button Content="Return to Pure HRIR" Click="PureHrir_Click"/><Button Content="Prepare HRIR / BRIR A/B" Click="CompareBrir_Click"/></WrapPanel>
    <WrapPanel><Button Content="Open BRIR profile…" Click="OpenBrir_Click"/><Button Content="Add stereo WAV / SOFA…" Click="AddBrir_Click"/><Button Content="Duplicate route" Click="DuplicateBrir_Click"/><Button Content="Remove route" Click="RemoveBrir_Click"/><Button Content="Save profile…" Click="SaveBrir_Click"/></WrapPanel>
    <TextBlock Text="Room / measurement name"/><TextBox x:Name="BrirName" Text="My measured room"/>
    <DataGrid x:Name="BrirGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="190" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="BrirRoute_Changed">
     <DataGrid.Columns><DataGridTextColumn Header="Speaker code" Binding="{Binding Channel}" Width="100"/><DataGridTextColumn Header="Stereo response file" Binding="{Binding File}" Width="*"/><DataGridTextColumn Header="M index (0…)" Binding="{Binding Measurement}" Width="110"/><DataGridTextColumn Header="Left ear (0/1)" Binding="{Binding LeftEar}" Width="105"/><DataGridTextColumn Header="Right ear (0/1)" Binding="{Binding RightEar}" Width="105"/></DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="Codes: FL FR FC SL SR BL BR BC LFE. WAV: index 0. SOFA: explicit measurement index (M). M can describe head rotations, not speaker positions; check the dataset instructions. Left/right here are ears, not physical left/right speakers." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
    <TextBox x:Name="BrirFileDetails" IsReadOnly="True" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Select a route to inspect its file. SOFA FIR-E / multiple emitters and fractional Data.Delay are currently rejected explicitly."/>
    <TextBlock Text="Measurement source / documentation URL"/><TextBox x:Name="BrirSource"/>
    <TextBlock Text="License / usage conditions (kept in export settings)"/><TextBox x:Name="BrirLicense"/>
    <CheckBox x:Name="BrirConfirmed" Content="I verified speaker positions, neutral head orientation and left/right ear order in the measurement documentation." Margin="0,8"/>
    <CheckBox x:Name="BrirDryLfe" Content="If no measured LFE response: explicitly send dry LFE to both ears (existing LFE gain applies)." Margin="0,4"/>
    <TextBlock x:Name="BrirStatus" Text="No measured room loaded. Stereo and Pure HRIR remain available." TextWrapping="Wrap" Margin="0,8"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="AdmSceneTab" Header="5 · ADM scene" IsEnabled="{Binding IsAdmPlaybackEnabled}"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="ProgrammeText" TextWrapping="Wrap" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,6">
     <TextBlock Text="Drag: orbit · Right-drag: pan · Wheel: zoom · Arrows: orbit / overhead · Home: default view" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="Click sphere: Solo / release · Shift+click: add/remove · Checkboxes: multiple Solo · Solo affects main preview only" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
     <DockPanel Margin="0,4"><Button x:Name="SceneSoloClear" DockPanel.Dock="Right" Content="Clear Solo" Click="ClearSceneSolo_Click" IsEnabled="False"/>
      <CheckBox x:Name="ShowSceneLabels" DockPanel.Dock="Right" Content="Show labels" IsChecked="True" Click="SceneLabels_Click" VerticalAlignment="Center" Margin="12,0,16,0" ToolTip="Show object numbers and channel names"/>
      <TextBlock x:Name="SceneSoloText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
    </StackPanel>
    <Border x:Name="SceneInput" Grid.Row="2" Background="#0B111B" CornerRadius="4" Focusable="True" FocusVisualStyle="{x:Null}"
            MouseDown="Scene_MouseDown" MouseMove="Scene_MouseMove" MouseUp="Scene_MouseUp" MouseWheel="Scene_MouseWheel"
            LostMouseCapture="Scene_LostCapture" PreviewKeyDown="Scene_KeyDown">
     <Grid>
      <Viewport3D x:Name="SceneView" ClipToBounds="True"><Viewport3D.Camera><PerspectiveCamera Position="2.5,4,8" LookDirection="-2.5,-3.6,-8" UpDirection="0,1,0" FieldOfView="65"/></Viewport3D.Camera></Viewport3D>
      <Canvas x:Name="SceneLabels" IsHitTestVisible="False" ClipToBounds="True" Visibility="{Binding IsChecked, ElementName=ShowSceneLabels, Converter={StaticResource SceneLabelsVisibilityConverter}}"/>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8,6" Background="#D5101923" BorderBrush="#555B4931" BorderThickness="1" CornerRadius="9" IsHitTestVisible="False">
       <StackPanel><TextBlock Text="F R O N T" Foreground="#FFF1CE" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <Canvas Width="58" Height="58">
         <Ellipse Width="44" Height="44" Canvas.Left="7" Canvas.Top="7" Stroke="#745B4931" StrokeThickness="1"/>
         <Ellipse Width="32" Height="32" Canvas.Left="13" Canvas.Top="13" Stroke="#405B4931" StrokeDashArray="1 4"/>
         <Path x:Name="SceneFrontGlow" Stroke="#40FFB85C" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
         <Path x:Name="SceneFrontArrow" Stroke="#FFD08A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
         <Ellipse Width="4" Height="4" Canvas.Left="27" Canvas.Top="27" Fill="#FFF1CE"/>
        </Canvas>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <DataGrid x:Name="ObjectsGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,8"><DataGrid.Columns>
     <DataGridTemplateColumn Header="Solo" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <CheckBox IsChecked="{Binding IsSolo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSolo}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding SoloLabel}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="110"/><DataGridTextColumn Header="Source" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="PCM track (zero-based)" Binding="{Binding TrackIndex}" Width="165"/><DataGridTextColumn Header="LFE" Binding="{Binding IsLfe}" Width="60"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="4"><ProgressBar x:Name="SceneTime" Minimum="0" Maximum="10" Height="5" Margin="0,8"/><TextBlock x:Name="SceneDetails" TextWrapping="Wrap" Margin="0,5"/>
     <TextBlock Text="Position display follows the main player. Use its track list, Play / Pause and timeline; set head orientation in Headphones." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
   </Grid></TabItem>
  </TabControl>
  <WrapPanel Grid.Row="2" Margin="0,8"><Button x:Name="LabCancelButton" Content="Cancel lab task" Click="Cancel_Click" IsEnabled="False"/></WrapPanel>
  <TextBox x:Name="StatusText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" Text="Ready. Choose a track in the main window, or open an ADM scene."/>
 </Grid>
</Window>
