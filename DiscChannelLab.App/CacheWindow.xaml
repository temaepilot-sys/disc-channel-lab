<Window x:Class="Disc2Flac.CacheWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Disc2Flac"
        Title="{local:Loc Key='キャッシュ管理'}" Width="500" SizeToContent="Height"
        ResizeMode="CanMinimize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="{local:Loc Key='キャッシュ'}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="CacheSizeLabel" Text="{Binding CacheSizeText}" FontSize="28"
                           FontWeight="SemiBold" Margin="0,8,0,12"/>
                <TextBlock Text="{Binding CacheDetailsText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,16,0,12">
                    <Button x:Name="ClearCacheButton" Content="{local:Loc Key='キャッシュをクリア'}"
                            Click="ClearCache_Click" IsEnabled="{Binding CanClearCache}" Margin="0,0,8,0"/>
                    <Button Content="{local:Loc Key='容量を更新'}" Click="RefreshCache_Click"/>
                </WrapPanel>
                <TextBlock Text="{Binding CacheClearHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Button Grid.Row="1" Content="{local:Loc Key='閉じる'}" Click="Close_Click"
                IsCancel="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,16,0,0"/>
    </Grid>
</Window>
